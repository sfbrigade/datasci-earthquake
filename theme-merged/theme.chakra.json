      "dvh": { "value": "100dvh" },
      "svh": { "value": "100svh" },
      "lvh": { "value": "100lvh" },
      "dvw": { "value": "100dvw" },
      "svw": { "value": "100svw" },
      "lvw": { "value": "100lvw" },
      "vw": { "value": "100vw" },
