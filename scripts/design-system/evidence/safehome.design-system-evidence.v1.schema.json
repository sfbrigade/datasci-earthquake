{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://safehome.report/schemas/safehome.design-system-evidence.v1.schema.json",
  "title": "SafeHome design-system evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceIdentity",
    "toolchain",
    "policies",
    "files",
    "sourceFacts",
    "moduleFacts",
    "reachabilityClaims",
    "semanticFacts",
    "claims",
    "coverage"
  ],
  "properties": {
    "schema": {"const": "safehome.design-system-evidence.v1"},
    "sourceIdentity": {"$ref": "#/definitions/sourceIdentity"},
    "toolchain": {"$ref": "#/definitions/toolchain"},
    "policies": {"$ref": "#/definitions/policies"},
    "files": {"type": "array", "items": {"$ref": "#/definitions/fileRecord"}},
    "sourceFacts": {"type": "array", "items": {"$ref": "#/definitions/sourceFact"}},
    "moduleFacts": {"type": "array", "items": {"$ref": "#/definitions/moduleFact"}},
    "reachabilityClaims": {"type": "array", "items": {"$ref": "#/definitions/reachabilityClaim"}},
    "semanticFacts": {"type": "array", "items": {"$ref": "#/definitions/semanticFact"}},
    "claims": {"type": "array", "items": {"$ref": "#/definitions/claim"}},
    "coverage": {"$ref": "#/definitions/coverage"}
  },
  "definitions": {
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseHead", "workspaceDirty"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "baseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workspaceDirty": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"workspaceDirty": {"const": false}}},
          "then": {"required": ["tree"]}
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "typescript", "chakra", "next"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "typescript": {"type": "string", "minLength": 1},
        "chakra": {"type": "string", "minLength": 1},
        "next": {"type": "string", "minLength": 1}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClassification", "entrypoint", "semantic", "claim"],
      "properties": {
        "sourceClassification": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "semantic": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["git-blob", "sha256"]},
        "value": {"type": "string", "pattern": "^[0-9a-f]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "git-blob"}}},
          "then": {"properties": {"value": {"pattern": "^[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "sha256"}}},
          "then": {"properties": {"value": {"pattern": "^[0-9a-f]{64}$"}}}
        }
      ]
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "path", "sourceClass", "contentIdentity", "analysisStatus"],
      "properties": {
        "fileId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sourceClass": {
          "enum": ["app-source", "theme", "storybook", "test", "test-support", "e2e", "archived", "tooling", "type-support", "other"]
        },
        "contentIdentity": {"$ref": "#/definitions/contentIdentity"},
        "analysisStatus": {"enum": ["complete", "partial", "failed", "excluded"]},
        "reason": {"type": "string"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "startLine": {"type": "integer", "minimum": 1},
        "startColumn": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "endColumn": {"type": "integer", "minimum": 1}
      }
    },
    "valueCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "value"],
      "properties": {
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "value": {"type": "string"}
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "fileId", "span", "kind", "resolution", "raw"],
      "properties": {
        "factId": {"type": "string", "minLength": 1},
        "fileId": {"type": "string", "minLength": 1},
        "span": {"$ref": "#/definitions/span"},
        "kind": {
          "enum": [
            "component-callsite",
            "style-property",
            "typed-style-value",
            "named-text-style",
            "named-layer-style",
            "recipe-variant",
            "style-literal",
            "unresolved-style"
          ]
        },
        "resolution": {"enum": ["exact", "bounded", "unresolved"]},
        "raw": {"type": "string"},
        "propPath": {"type": "string"},
        "component": {"type": "string"},
        "domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "values": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "valueCases": {"type": "array", "items": {"$ref": "#/definitions/valueCase"}}
      }
    },
    "moduleFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleFactId", "fromFileId", "kind", "specifier"],
      "properties": {
        "moduleFactId": {"type": "string", "minLength": 1},
        "fromFileId": {"type": "string", "minLength": 1},
        "toFileId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["static-import", "dynamic-import", "asset-import", "unresolved-import"]},
        "specifier": {"type": "string"}
      }
    },
    "reachabilityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachabilityClaimId", "fileId", "kind", "policy", "realms"],
      "properties": {
        "reachabilityClaimId": {"type": "string", "minLength": 1},
        "fileId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["reachable", "source-only", "uncertain"]},
        "policy": {"type": "string", "minLength": 1},
        "realms": {"type": "array", "uniqueItems": true, "items": {"enum": ["product", "internal-demo"]}},
        "entrypointFileIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "semanticFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticFactId", "kind", "originFactIds"],
      "properties": {
        "semanticFactId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["explicit-token", "named-style", "semantic-implication", "recipe-default", "recipe-variant", "color-palette-context", "non-token-style"]},
        "originFactIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "entity": {"type": "string"},
        "entities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "recipe": {"type": "string"},
        "variant": {"type": "string"},
        "value": {"type": "string"},
        "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "virtual": {"type": "boolean"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "kind", "entity", "policy", "basis"],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["product-path-reference", "internal-demo-reference", "source-only-reference", "semantic-product-path-reference", "dependency-only", "no-resolved-reference", "strong-negative-eligible", "strong-negative-blocked", "review-for-removal"]
        },
        "entity": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1},
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceFactIds": {"type": "array", "items": {"type": "string"}},
            "semanticFactIds": {"type": "array", "items": {"type": "string"}},
            "moduleFactIds": {"type": "array", "items": {"type": "string"}},
            "reachabilityClaimIds": {"type": "array", "items": {"type": "string"}}
          }
        },
        "realms": {"type": "array", "uniqueItems": true, "items": {"enum": ["product", "internal-demo"]}},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibleFiles", "completeFiles", "partialFiles", "failedFiles", "excludedFiles", "unresolvedFacts"],
      "properties": {
        "eligibleFiles": {"type": "integer", "minimum": 0},
        "completeFiles": {"type": "integer", "minimum": 0},
        "partialFiles": {"type": "integer", "minimum": 0},
        "failedFiles": {"type": "integer", "minimum": 0},
        "excludedFiles": {"type": "integer", "minimum": 0},
        "unresolvedFacts": {"type": "integer", "minimum": 0},
        "bySourceClass": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "unresolvedByDomain": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
